# Local defaults for SQLite development
DATABASE_URL=sqlite:///./drainpulse.db

# Optional PostgreSQL/PostGIS configuration for a real spatial database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=drainpulse
POSTGRES_USER=drainpulse
POSTGRES_PASSWORD=drainpulse

# Private S3 object storage. Boto3 uses the standard AWS credential chain
# (environment credentials, shared config/profile, container credentials, or IAM role).
STORAGE_BACKEND=s3
AWS_S3_BUCKET=drainpulseai-evidence-vk-2026
AWS_REGION=ap-southeast-2
# Leave empty for AWS S3. Set only when using an S3-compatible endpoint such as LocalStack.
AWS_ENDPOINT_URL_S3=
